#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$BASH_SOURCE")" && pwd)"

if command -v node >/dev/null 2>&1; then
  exec node "$SCRIPT_DIR/zhihu-verify.mjs" "$@"
fi

if [[ -x "$HOME/.local/bin/mise" ]]; then
  exec "$HOME/.local/bin/mise" x node@22 -- node "$SCRIPT_DIR/zhihu-verify.mjs" "$@"
fi

echo "zhihu-verify requires Node.js 20 or newer" >&2
exit 1
