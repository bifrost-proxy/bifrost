{
  "name": "bifrost-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:test": "node --test scripts/docs-sync-lib.test.mjs",
    "docs:verify": "node scripts/verify-docs-sync.mjs",
    "home:build": "node scripts/build-home.mjs",
    "home:test": "node --test scripts/home-static.test.mjs",
    "home:verify": "node scripts/verify-home.mjs",
    "site:verify-links": "node scripts/verify-site-links.mjs",
    "test": "node --test scripts/docs-sync-lib.test.mjs scripts/home-static.test.mjs scripts/docs-home-link.test.mjs scripts/write-redirects.test.mjs",
    "dev": "node scripts/sync-docs.mjs && vitepress dev .",
    "build": "rm -rf dist && node scripts/sync-docs.mjs && node scripts/verify-docs-sync.mjs && vitepress build . && node scripts/write-redirects.mjs && node scripts/build-home.mjs && node scripts/verify-home.mjs && node scripts/verify-site-links.mjs",
    "preview": "pnpm run build && vitepress preview ."
  },
  "dependencies": {
    "vitepress": "latest",
    "vue": "latest"
  }
}
