{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifrost",
  "version": "0.0.144",
  "identifier": "com.bifrost.desktop",
  "build": {
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/bifrost.png",
      "../../assets/bifrost.icns",
      "../../assets/bifrost.ico"
    ],
    "resources": [
      "resources/bin/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "bifrost"
        ],
        "name": "Bifrost Capture or Rules Package",
        "description": "Bifrost capture, rules, replay, script, or values package",
        "mimeType": "application/x-bifrost",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.bifrost.desktop.bifrost",
          "conformsTo": [
            "public.data",
            "public.text"
          ]
        }
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bifrost"
        ]
      }
    }
  }
}
